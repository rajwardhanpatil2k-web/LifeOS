PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/life_os
TZ=Asia/Kolkata
OPENAI_API_KEY=

# Render / production
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/life_os?retryWrites=true&w=majority
# SEED_ON_START=true
# OPENAI_API_KEY=sk-...

# Phone APK (baked in at build time)
# EXPO_PUBLIC_API_URL=https://lifeos-1vvx.onrender.com

# Static login. Used only when no account exists yet (first boot) or via npm run auth:set.
# LIFEOS_LOGIN_USER=raj
# LIFEOS_LOGIN_PASSWORD=change-me-now
# When set, the browser dashboard may only call the API from this origin.
# With it unset, browsers are limited to localhost. The phone app sends no origin.
# LIFEOS_WEB_ORIGIN=https://lifeos-1vvx.onrender.com

# Encryption at rest is an Atlas cluster setting. This app does not turn it on.
# Confirm it in the Atlas console before treating production data as encrypted.
# Atlas network access of 0.0.0.0/0 is acceptable only because the API requires login.

# Release builds accept only an https:// server URL. Local development can still use http://127.0.0.1:4000.
