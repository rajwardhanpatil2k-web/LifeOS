{
  "expo": {
    "name": "Life OS",
    "slug": "life-os",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "lifeos",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B0D"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#d4af6a",
      "androidMode": "default",
      "androidCollapsedTitle": "Life OS"
    },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.raj.lifeos" },
    "extra": {
      "apiUrl": "https://lifeos-raj.onrender.com"
    },
    "android": {
      "package": "com.raj.lifeos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0B0D"
      },
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "WAKE_LOCK",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "RECEIVE_BOOT_COMPLETED",
        "USE_FULL_SCREEN_INTENT",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Life OS needs the camera to scan your wake QR code and silence the morning alarm."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#d4af6a",
          "defaultChannel": "lifeos-normal"
        }
      ]
    ]
  }
}
